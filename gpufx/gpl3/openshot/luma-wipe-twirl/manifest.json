{
  "api": 1,
  "id": "io.github.tqk2811.gpl3.openshot.luma-wipe-twirl",
  "name": "Luma Wipe: Twirl (OpenShot)",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A wipe that follows the brightness of one of 53 OpenShot grayscale luma images (twirls, whirlpools and spirals): dark areas switch to the second clip first. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "pattern",
      "type": "enum",
      "values": [
        "foggy_spiral_1",
        "spiral_1",
        "spiral_2",
