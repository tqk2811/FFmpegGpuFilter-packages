        "textures/wandering_7.png",
        "textures/wandering_8.png",
        "textures/wandering_9.png"
      ]
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/luma_wipe.wgsl"
        }
      ]
    }
  ]
}
