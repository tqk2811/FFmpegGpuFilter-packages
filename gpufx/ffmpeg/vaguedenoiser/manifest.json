{
  "api": 1,
  "id": "io.github.tqk2811.vaguedenoiser",
  "name": "Vague Denoiser",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Wavelet denoiser on one frame: shrinks the small wavelet coefficients of each channel.",
  "inputs": [
    {
      "name": "src",
      "description": "Picture to denoise"
    }
  ],
  "params": [
    {
      "name": "threshold",
      "type": "float",
      "default": 2.0,
      "min": 0.0,
      "max": 255.0,
      "description": "Filtering strength: coefficients up to this size are shrunk"
    },
    {
      "name": "method",
      "type": "enum",
      "values": [
        "hard",
        "soft",
        "garrote"
      ],
      "default": "garrote",
      "description": "Shrinking of the coefficients above the threshold: kept, moved toward 0 by the threshold, or non-negative garrote"
    },
    {
      "name": "nsteps",
      "type": "int",
      "default": 6,
      "min": 1,
      "max": 10,
      "description": "Number of wavelet decomposition steps (lowered for small pictures as FFmpeg does)"
    },
    {
      "name": "percent",
      "type": "float",
      "default": 85.0,
      "min": 0.0,
      "max": 100.0,
      "description": "Percent of full denoising of the coefficients below the threshold"
    },
    {
      "name": "planes",
      "type": "int",
      "default": 15,
      "min": 0,
      "max": 15,
      "description": "Channels to filter, FFmpeg's bits on gbrp: 1 green, 2 blue, 4 red"
    },
    {
      "name": "threshold_type",
      "type": "enum",
      "values": [
        "universal",
        "bayes"
      ],
      "default": "universal",
      "description": "Threshold: the same for the whole picture (VisuShrink), or one per sub-band from its energy (BayesShrink)"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/first.wgsl",
          "entry": "fh0",
          "inputs": [
            "src"
          ],
          "outputs": [
            "br",
            "bg",
            "bb"
          ]
        },
        {
          "shader": "shaders/b.wgsl",
          "entry": "fv0",
          "inputs": [
            "br",
            "bg",
            "bb"
          ],
