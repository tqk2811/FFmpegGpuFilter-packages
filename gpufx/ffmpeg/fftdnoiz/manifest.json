{
  "api": 1,
  "id": "io.github.tqk2811.fftdnoiz",
  "name": "FFT Denoiser",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "FFT block denoiser on one frame: scales down the weak frequencies of overlapping windowed blocks.",
  "inputs": [{ "name": "src", "description": "Picture to denoise" }],
  "params": [
    { "name": "sigma", "type": "float", "default": 1.0, "min": 0.0, "max": 100.0, "description": "Denoising strength" },
    { "name": "amount", "type": "float", "default": 1.0, "min": 0.01, "max": 1.0, "description": "Amount of denoising: the weakest frequencies keep 1 - amount of their size" },
    { "name": "block", "type": "int", "default": 32, "min": 8, "max": 64, "description": "Block size in pixels" },
    { "name": "overlap", "type": "float", "default": 0.5, "min": 0.2, "max": 0.8, "description": "Overlap of the blocks, as a fraction of the block size" },
    { "name": "method", "type": "enum", "values": ["wiener", "hard"], "default": "wiener", "description": "Scaling of each frequency: Wiener filter from its power, or hard threshold" },
    { "name": "planes", "type": "int", "default": 7, "min": 0, "max": 15, "description": "Channels to filter, FFmpeg's bits on gbrp: 1 green, 2 blue, 4 red" },
    { "name": "window", "type": "enum", "values": ["rect", "bartlett", "hann", "hanning", "hamming", "blackman", "welch", "flattop", "bharris", "bnuttall", "bhann", "sine", "nuttall", "lanczos", "gauss", "tukey", "cauchy", "parzen", "poisson", "bohman", "kaiser"], "default": "hanning", "description": "Window function of the blocks" }
  ],
  "groups": [{ "passes": [
    { "shader": "shaders/block.wgsl", "entry": "red", "inputs": ["src"], "outputs": ["dr"] },
    { "shader": "shaders/block.wgsl", "entry": "green", "inputs": ["src"], "outputs": ["dg"] },
    { "shader": "shaders/block.wgsl", "entry": "blue", "inputs": ["src"], "outputs": ["db"] },
    { "shader": "shaders/merge.wgsl", "inputs": ["src", "dr", "dg", "db"], "outputs": ["out"] }
  ] }]
}
