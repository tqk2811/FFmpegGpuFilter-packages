{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.swap",
  "name": "Swap",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The two clips swap places in 3D, with a floor reflection. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "reflection",
      "type": "float",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "description": "Strength of the reflection"
    },
    {
      "name": "perspective",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 0.9,
      "description": "Amount of perspective"
    },
    {
      "name": "depth",
      "type": "float",
      "default": 3.0,
      "min": 1,
      "max": 10,
      "description": "How far back the clips go"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/swap.wgsl"
        }
      ]
    }
  ]
}
