{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.aperture-wipe",
  "name": "Aperture Wipe",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A camera aperture opens its turning blades to reveal the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "blades",
      "type": "int",
      "default": 6,
      "min": 3,
      "max": 12,
      "description": "Number of blades"
    },
    {
      "name": "rotation",
      "type": "float",
      "default": 60.0,
      "min": -180,
      "max": 180,
      "description": "How much the blades turn while opening, in degrees"
    },
    {
      "name": "shadow",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "How dark the blades are shaded along their edges"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/aperture_wipe.wgsl"
        }
      ]
    }
  ]
}
