{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.plus-wipe",
  "name": "Plus Wipe",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A plus-shaped cross grows from the center and widens until the second clip fills the frame. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "smoothness",
      "type": "float",
      "default": 0.01,
      "min": 0,
      "max": 0.1,
      "description": "Softness of the edge"
    },
    {
      "name": "reverse",
      "type": "bool",
      "default": false,
      "description": "Close four corner rectangles toward the middle instead"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/plus_wipe.wgsl"
        }
      ]
    }
  ]
}
