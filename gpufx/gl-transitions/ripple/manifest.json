{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.ripple",
  "name": "Ripple",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Ripples spread from the center while the clips crossfade. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "amplitude",
      "type": "float",
      "default": 100.0,
      "min": 0,
      "max": 500,
      "description": "Frequency of the ripples"
    },
    {
      "name": "speed",
      "type": "float",
      "default": 50.0,
      "min": 0,
      "max": 200,
      "description": "Speed of the ripples"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/ripple.wgsl"
        }
      ]
    }
  ]
}
