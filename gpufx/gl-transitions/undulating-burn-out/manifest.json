{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.undulating-burn-out",
  "name": "Undulating Burn Out",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A circle with a wavy, burning edge grows from a point to reveal the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "smoothness",
      "type": "float",
      "default": 0.03,
      "min": 0,
      "max": 0.5,
      "description": "Softness of the edge"
    },
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Center of the circle (0..1, y down)"
    },
    {
      "name": "color",
      "type": "color",
      "default": "#000000",
      "description": "Color of the burning edge"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/undulating_burn_out.wgsl"
        }
      ]
    }
  ]
}
