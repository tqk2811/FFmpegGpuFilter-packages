{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.rotate-scale-vanish",
  "name": "Rotate Scale Vanish",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The first clip spins and shrinks away over the second. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "fade_in_second",
      "type": "bool",
      "default": true,
      "description": "Fade in the second clip"
    },
    {
      "name": "reverse_effect",
      "type": "bool",
      "default": false,
      "description": "Run the effect in reverse"
    },
    {
      "name": "reverse_rotation",
      "type": "bool",
      "default": false,
      "description": "Rotate the other way"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/rotate_scale_vanish.wgsl"
        }
      ]
    }
  ]
}
