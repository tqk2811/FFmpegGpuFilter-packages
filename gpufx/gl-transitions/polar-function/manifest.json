{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.polar-function",
  "name": "Polar Function",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A flower shape with several petals grows from the center to reveal the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "segments",
      "type": "int",
      "default": 5,
      "min": 1,
      "max": 50,
      "description": "Number of petals"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/polar_function.wgsl"
        }
      ]
    }
  ]
}
