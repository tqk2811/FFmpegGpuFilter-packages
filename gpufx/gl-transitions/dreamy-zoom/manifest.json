{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.dreamy-zoom",
  "name": "Dreamy Zoom",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Zooms and rotates into a bright flash, then out to the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "rotation",
      "type": "float",
      "default": 6.0,
      "min": -90,
      "max": 90,
      "description": "Rotation, in degrees"
    },
    {
      "name": "scale",
      "type": "float",
      "default": 1.2,
      "min": 0.1,
      "max": 10,
      "description": "Zoom at the flash"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/dreamy_zoom.wgsl"
        }
      ]
    }
  ]
}
