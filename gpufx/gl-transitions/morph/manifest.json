{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.morph",
  "name": "Morph",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A crossfade in which each clip is displaced by the other's colors. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "strength",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "description": "Strength of the displacement"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/morph.wgsl"
        }
      ]
    }
  ]
}
