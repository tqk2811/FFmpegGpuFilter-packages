{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.butterfly-wave-scrawler",
  "name": "Butterfly Wave Scrawler",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Wavy, color-separated ripples scramble the first clip into the second. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "amplitude",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 5,
      "description": "Strength of the waves"
    },
    {
      "name": "waves",
      "type": "float",
      "default": 30.0,
      "min": 0,
      "max": 100,
      "description": "Number of waves"
    },
    {
      "name": "color_separation",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "description": "Separation of the red and blue channels"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/butterfly_wave_scrawler.wgsl"
        }
      ]
    }
  ]
}
