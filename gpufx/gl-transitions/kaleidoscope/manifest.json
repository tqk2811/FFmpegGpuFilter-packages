{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.kaleidoscope",
  "name": "Kaleidoscope",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A crossfade through a spinning kaleidoscope. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "speed",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 10,
      "description": "Spin speed"
    },
    {
      "name": "angle",
      "type": "float",
      "default": 1.0,
      "min": -6.3,
      "max": 6.3,
      "description": "Angle added at each fold, in radians"
    },
    {
      "name": "power",
      "type": "float",
      "default": 1.5,
      "min": 0.1,
      "max": 10,
      "description": "Easing power of the spin"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/kaleidoscope.wgsl"
        }
      ]
    }
  ]
}
