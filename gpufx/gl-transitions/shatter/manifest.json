{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.shatter",
  "name": "Shatter",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The first clip cracks like a pane of glass from an impact point, then its shards break loose and fall away tumbling in 3D, revealing the second. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Impact point (0..1, y down)"
    },
    {
      "name": "shards",
      "type": "float",
      "default": 6.0,
      "min": 3,
      "max": 8,
      "description": "Approximate number of rows of shards"
    },
    {
      "name": "gravity",
      "type": "float",
      "default": 1.0,
      "min": 0.5,
      "max": 3,
      "description": "Strength of the gravity"
    },
    {
      "name": "seed",
      "type": "float",
      "default": 0.0,
      "min": 0,
      "max": 1000,
      "description": "Random seed: another value gives other shards"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/shatter.wgsl"
        }
      ]
    }
  ]
}
