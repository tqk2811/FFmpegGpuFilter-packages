{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.rotate-scale-fade",
  "name": "Rotate Scale Fade",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The picture spins and zooms while the clips crossfade, over a background color. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Center of the rotation (0..1, y down)"
    },
    {
      "name": "rotations",
      "type": "float",
      "default": 1.0,
      "min": -10,
      "max": 10,
      "description": "Number of turns"
    },
    {
      "name": "scale",
      "type": "float",
      "default": 8.0,
      "min": 1,
      "max": 50,
      "description": "Maximum zoom out"
    },
    {
      "name": "back_color",
      "type": "color",
      "default": "#262626",
      "description": "Background color"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/rotate_scale_fade.wgsl"
        }
      ]
    }
  ]
}
