{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.crazy-parametric-fun",
  "name": "Crazy Parametric Fun",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The first clip is pulled along a parametric curve into a psychedelic swirl. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "a",
      "type": "float",
      "default": 4.0,
      "min": 0.1,
      "max": 10,
      "description": "First parameter of the curve"
    },
    {
      "name": "b",
      "type": "float",
      "default": 1.0,
      "min": 0.1,
      "max": 10,
      "description": "Second parameter of the curve"
    },
    {
      "name": "amplitude",
      "type": "float",
      "default": 120.0,
      "min": 0,
      "max": 500,
      "description": "Strength of the distortion"
    },
    {
      "name": "smoothness",
      "type": "float",
      "default": 0.1,
      "min": 0.01,
      "max": 1,
      "description": "Smoothness of the distortion (smaller moves the picture further)"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/crazy_parametric_fun.wgsl"
        }
      ]
    }
  ]
}
