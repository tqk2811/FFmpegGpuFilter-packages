{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.rectangle-cover",
  "name": "Rectangle Cover",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A rectangle of color grows from the center to cover the first clip, then shrinks to show the second. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "color",
      "type": "color",
      "default": "#0d0d0d",
      "description": "Color of the rectangle"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/rectangle_cover.wgsl"
        }
      ]
    }
  ]
}
