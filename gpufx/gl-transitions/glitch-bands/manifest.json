{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.glitch-bands",
  "name": "Glitch Bands",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A crossfade with glitchy bands and color shifts. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "ampx",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 5,
      "description": "Horizontal amplitude of the glitch"
    },
    {
      "name": "ampy",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 5,
      "description": "Vertical amplitude of the glitch"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/glitch_bands.wgsl"
        }
      ]
    }
  ]
}
