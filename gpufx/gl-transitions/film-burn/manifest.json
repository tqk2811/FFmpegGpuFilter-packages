{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.film-burn",
  "name": "Film Burn",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Glowing film-burn light leaks wash over the picture and reveal the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "seed",
      "type": "float",
      "default": 2.31,
      "description": "Random seed"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/film_burn.wgsl"
        }
      ]
    }
  ]
}
