{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.fall-over",
  "name": "Fall Over",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The first clip falls over backward, hinged on its bottom edge, revealing the second behind it. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "perspective",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "description": "Strength of the perspective"
    },
    {
      "name": "shading",
      "type": "float",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "description": "How much the clip darkens as it falls"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/fall_over.wgsl"
        }
      ]
    }
  ]
}
