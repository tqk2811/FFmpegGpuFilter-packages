{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.star-wipe",
  "name": "Star Wipe",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A growing star with a colored border reveals the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "border_thickness",
      "type": "float",
      "default": 0.01,
      "min": 0,
      "max": 0.2,
      "description": "Thickness of the border"
    },
    {
      "name": "star_rotation",
      "type": "float",
      "default": 0.75,
      "min": 0,
      "max": 1,
      "description": "Rotation of the star, in fifths of a turn"
    },
    {
      "name": "border_color",
      "type": "color",
      "default": "#ffffff",
      "description": "Color of the border"
    },
    {
      "name": "star_center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Center of the star (0..1, y down)"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/star_wipe.wgsl"
        }
      ]
    }
  ]
}
