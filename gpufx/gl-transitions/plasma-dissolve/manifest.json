{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.plasma-dissolve",
  "name": "Plasma Dissolve",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A flowing demo-style plasma draws moving bands through which the second clip spreads like tendrils, with a glowing edge. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "scale",
      "type": "float",
      "default": 3.0,
      "min": 0.5,
      "max": 10,
      "description": "Size of the plasma (higher: more, thinner bands)"
    },
    {
      "name": "smoothness",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 0.5,
      "description": "Softness of the band edges"
    },
    {
      "name": "flow",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 1,
      "description": "How much the plasma flows"
    },
    {
      "name": "edge_color",
      "type": "color",
      "default": "#ff73e6",
      "description": "Color of the glow along the edges"
    },
    {
      "name": "edge_strength",
      "type": "float",
      "default": 0.6,
      "min": 0,
      "max": 2,
      "description": "Strength of the glow"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/plasma_dissolve.wgsl"
        }
      ]
    }
  ]
}
