{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.strip-datamosh-glitch",
  "name": "Strip Datamosh Glitch",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A datamosh glitch: torn strips, chroma shifts and scan noise drag the first clip into the second one. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "strength",
      "type": "float",
      "default": 1.0,
      "min": 0,
      "max": 2,
      "description": "Overall strength of the glitch"
    },
    {
      "name": "horizontal_bars",
      "type": "float",
      "default": 42.0,
      "min": 4,
      "max": 120,
      "description": "Number of horizontal bars across the frame's height"
    },
    {
      "name": "vertical_slits",
      "type": "float",
      "default": 18.0,
      "min": 2,
      "max": 60,
      "description": "Number of vertical slits across the frame's width"
    },
    {
      "name": "tear",
      "type": "float",
      "default": 0.18,
      "min": 0,
      "max": 0.5,
      "description": "How far the strips are torn sideways"
    },
    {
      "name": "chroma",
      "type": "float",
      "default": 0.032,
      "min": 0,
      "max": 0.1,
      "description": "Distance between the red and blue channels"
    },
    {
      "name": "residue",
      "type": "float",
      "default": 0.62,
      "min": 0,
      "max": 1,
      "description": "Strength of the smeared slices left in the torn strips"
    },
    {
      "name": "noise_amount",
      "type": "float",
      "default": 0.16,
      "min": 0,
      "max": 0.5,
      "description": "Strength of the noise"
    },
    {
      "name": "scan_amount",
      "type": "float",
      "default": 0.13,
      "min": 0,
      "max": 0.5,
      "description": "Strength of the scanlines"
    },
    {
      "name": "flash_amount",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "description": "Brightness of the strobe flashes"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/strip_datamosh_glitch.wgsl"
        }
      ]
    }
  ]
}
