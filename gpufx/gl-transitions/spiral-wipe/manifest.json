{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.spiral-wipe",
  "name": "Spiral Wipe",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A spiral arm winds out from the center and widens to reveal the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "turns",
      "type": "float",
      "default": 3.0,
      "min": 2,
      "max": 8,
      "description": "Number of turns of the spiral"
    },
    {
      "name": "smoothness",
      "type": "float",
      "default": 0.05,
      "min": 0,
      "max": 0.5,
      "description": "Softness of the arm edges"
    },
    {
      "name": "clockwise",
      "type": "bool",
      "default": true,
      "description": "Wind clockwise (false: counterclockwise)"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/spiral_wipe.wgsl"
        }
      ]
    }
  ]
}
