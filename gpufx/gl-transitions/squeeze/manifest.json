{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.squeeze",
  "name": "Squeeze",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The first clip is squeezed into a line with color separation, revealing the second. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "color_separation",
      "type": "float",
      "default": 0.04,
      "min": 0,
      "max": 0.5,
      "description": "Amount of color separation"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/squeeze.wgsl"
        }
      ]
    }
  ]
}
