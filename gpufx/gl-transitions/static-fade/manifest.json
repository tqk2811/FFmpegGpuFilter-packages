{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.static-fade",
  "name": "Static Fade",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Cuts to the second clip halfway, hidden behind a burst of TV static. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "noise_pixels",
      "type": "float",
      "default": 200.0,
      "min": 10,
      "max": 1000,
      "description": "Number of static pixels across the frame"
    },
    {
      "name": "luminosity",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "description": "Brightness of the static"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/static_fade.wgsl"
        }
      ]
    }
  ]
}
