{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.diamond-wipe",
  "name": "Diamond Wipe",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "A soft-edged diamond grows from a point to reveal the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "center",
      "type": "vec2",
      "default": [
        0.5,
        0.5
      ],
      "description": "Center of the diamond (0..1, y down)"
    },
    {
      "name": "smoothness",
      "type": "float",
      "default": 0.03,
      "min": 0,
      "max": 0.5,
      "description": "Softness of the edge"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/diamond_wipe.wgsl"
        }
      ]
    }
  ]
}
