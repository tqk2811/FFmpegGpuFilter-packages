{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.power-kaleido",
  "name": "Power Kaleido",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The picture folds into an animated kaleidoscope before revealing the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "scale",
      "type": "float",
      "default": 2.0,
      "min": 0.1,
      "max": 10,
      "description": "Size of the mirror cells"
    },
    {
      "name": "z",
      "type": "float",
      "default": 1.5,
      "min": 0.1,
      "max": 5,
      "description": "Zoom"
    },
    {
      "name": "speed",
      "type": "float",
      "default": 5.0,
      "min": -20,
      "max": 20,
      "description": "Rotation speed"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/power_kaleido.wgsl"
        }
      ]
    }
  ]
}
