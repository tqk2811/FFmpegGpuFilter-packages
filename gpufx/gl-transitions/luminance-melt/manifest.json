{
  "api": 1,
  "id": "io.github.tqk2811.gl-transitions.luminance-melt",
  "name": "Luminance Melt",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The first clip melts away in noisy vertical streaks, depending on its brightness. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    },
    {
      "name": "down",
      "type": "bool",
      "default": true,
      "description": "Melt downward (false: upward)"
    },
    {
      "name": "threshold",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "description": "Luminance threshold"
    },
    {
      "name": "above",
      "type": "bool",
      "default": false,
      "description": "Melt the parts above the threshold instead of below"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/luminance_melt.wgsl"
        }
      ]
    }
  ]
}
